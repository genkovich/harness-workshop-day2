# Модель у форматі провайдер/модель. Як і вчора: Qwen 3.8 на Groq Free і той самий ключ.
# Обрав іншого провайдера з таблиці в runbooks/00-setup.md: зміни MODEL і заповни лише його ключ.
MODEL=groq/qwen/qwen3.8-27b
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

TELEGRAM_BOT_TOKEN=
